# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/sportssphere?retryWrites=true&w=majority


# JWT Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Email Configuration (nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@sportssphere.com

# Payment Gateway (Legacy Mock)
PAYMENT_API_KEY=test_payment_key
PAYMENT_SECRET=test_payment_secret

# JazzCash MPay Integration (leave placeholders or set PAYMENT_MOCK_MODE=true for instant demo payments)
PAYMENT_MOCK_MODE=true
JAZZ_MERCHANT_ID=your_jazzcash_merchant_id
JAZZ_PASSWORD=your_jazzcash_password
JAZZ_INTEGRITY_SALT=your_jazzcash_integrity_salt
JAZZ_RETURN_URL=http://localhost:5173/payment/return
JAZZ_IPN_URL=https://your-ngrok-url.ngrok.io/api/payment/ipn
JAZZ_ENV=sandbox

# AI Service URL
AI_SERVICE_URL=http://localhost:5001

# Gemini API (general badminton questions)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=10000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Credentials (for initial admin user creation)
ADMIN_EMAIL=admin@sportssphere.com
ADMIN_PASSWORD=your_secure_admin_password
